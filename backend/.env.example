# edge-tts voice configuration (no API key required)
EDGE_TTS_VOICE_EN=en-SG-LunaNeural
EDGE_TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=-10%

# Reserved for the future evaluation service. Never commit a real key.
DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=90000

# Local faster-whisper service
ASR_SERVICE_URL=http://127.0.0.1:8000
ASR_TIMEOUT_MS=300000
